{
  "name": "market-data-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:check": "node ./scripts/check-db.mjs",
    "data:daily:schema": "node ./scripts/apply-korean-equity-daily-schema.mjs",
    "data:daily:collect": "node ./scripts/run-cybos-daily.mjs",
    "data:daily:import": "node ./scripts/import-korean-equity-daily.mjs",
    "data:daily:check": "node ./scripts/check-korean-equity-daily.mjs",
    "data:daily:update": "node ./scripts/update-korean-equity-bars.mjs --command update --type daily --mode incremental",
    "bars:update": "node ./scripts/update-korean-equity-bars.mjs --command update",
    "bars:status": "node ./scripts/update-korean-equity-bars.mjs --command status",
    "data:market-cap:update": "node ./scripts/update-korean-equity-market-cap.mjs --command update",
    "data:market-cap:status": "node ./scripts/update-korean-equity-market-cap.mjs --command status",
    "data:minute:schema": "node ./scripts/apply-korean-equity-minute-schema.mjs",
    "data:minute:import": "node ./scripts/import-korean-equity-minute-1m.mjs",
    "data:minute:check": "node ./scripts/check-korean-equity-minute-1m.mjs",
    "data:minute:update": "node ./scripts/update-korean-equity-bars.mjs --command update --type minute --mode incremental",
    "data:minute:audit": "node ./scripts/audit-korean-equity-minute-coverage.mjs",
    "data:minute:backfill-all": "node ./scripts/backfill-korean-equity-minute-all-symbols.mjs",
    "data:index:schema": "node ./scripts/apply-korean-market-index-schema.mjs",
    "data:index:import": "node ./scripts/import-korean-market-index.mjs",
    "data:index:check": "node ./scripts/check-korean-market-index.mjs",
    "data:index:update": "node ./scripts/update-korean-market-index.mjs",
    "data:sox:update": "node ./scripts/update-sox-daily.mjs",
    "data:sox:check": "node ./scripts/check-sox-daily.mjs",
    "data:update": "npm run data:daily:update && npm run data:minute:update && npm run data:market-cap:update && npm run data:index:update",
    "test": "node --test ./tests/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "mysql2": "^3.14.4"
  },
  "engines": {
    "node": ">=24"
  }
}
