# Copy to .env and replace with the real local MySQL credentials.
# Do not commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
# Optional. Defaults to market_data when omitted.
MYSQL_DATABASE=market_data

# Optional alternative: when MYSQL_URL is set, it overrides the split settings above.
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/market_data
